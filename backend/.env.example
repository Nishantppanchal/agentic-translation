# ---------------------------------------------------------------------------
# Models: every role calls an OpenAI-compatible endpoint directly — a vLLM server, no router in between.
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --port 8100 --enable-auto-tool-choice --tool-call-parser hermes
# (the backend itself uses port 8000, so run vLLM on another port)
#
#   MODEL             the served model name, exactly as GET <MODEL_API_BASE>/models lists it
#   MODEL_API_BASE    the server's /v1 URL
#   MODEL_API_KEY     vLLM's --api-key, if you set one (sent as "Authorization: Bearer ...")
#   MODEL_HEADERS     extra HTTP headers on every request, as a JSON object (e.g. a gateway or proxy token)
#   MODEL_EXTRA_BODY  extra request fields vLLM accepts, as a JSON object (e.g. sampling options)
#
# OCR (reads pages) and OCR_CHECK (checks the reading) need a vision model — MODEL by default; the editor needs
# tool calling (the two flags above). Any OpenAI-compatible service works the same way, e.g. OpenRouter for
# testing: <ROLE>_API_BASE=https://openrouter.ai/api/v1, <ROLE>_MODEL=qwen/qwen3-vl-8b-instruct, <ROLE>_API_KEY=...
# Failed calls are logged as "vLLM error — <role> model <name> at <url>: <the server's message>".
# ---------------------------------------------------------------------------
MODEL=Qwen/Qwen3-VL-8B-Instruct
MODEL_API_BASE=http://localhost:8100/v1
# MODEL_API_KEY=
# MODEL_HEADERS={"X-Gateway-Token": "..."}
# MODEL_EXTRA_BODY={"top_k": 20}

# Per-role overrides: <ROLE>_MODEL, _API_BASE, _API_KEY, _HEADERS, _EXTRA_BODY for
# OCR, OCR_CHECK, TRANSLATE, REVIEW, EDITOR and LQA. Each one a role leaves unset is inherited from MODEL_*.
# A role's own _HEADERS / _EXTRA_BODY replaces the default (not merged); set it to {} to send none.
# Example: a larger text model on a second server for translation and review.
# TRANSLATE_MODEL=Qwen/Qwen3-32B
# TRANSLATE_API_BASE=http://gpu-2:8100/v1
# REVIEW_MODEL=Qwen/Qwen3-32B
# REVIEW_API_BASE=http://gpu-2:8100/v1
# EDITOR_MODEL=          # needs tool calling
# LQA_MODEL=             # quality scoring; unset = the review endpoint, set another for a second opinion

# Dictionary service (any endpoint answering the contract in dictionary-server/README.md; blank = off).
# A dummy one for development: python3 dictionary-server/server.py
# DICTIONARY_URL=http://localhost:8200/lookup
# DICTIONARY_API_KEY=
# DICTIONARY_HEADERS={"X-Client": "translator"}

# Pipeline
OCR_DPI=150
OCR_CHECK_ENABLED=true     # OCR check: small fixes (or ones the PDF's text layer confirms) applied, others listed
FIGURE_DETECTION=auto      # auto (the PDF's embedded images + pictures PP-DocLayoutV3 finds) | off
FIGURE_TEXT=true           # read the text inside figures and translate it as a legend

# The layout MCP server: PP-DocLayoutV3 finds the pictures on pages (blank LAYOUT_SERVER_DIR: PDF images only)
LAYOUT_SERVER_DIR=../layout-server
LAYOUT_MODEL=PP-DocLayoutV3
# Where the PP-DocLayoutV3 model files are, e.g. on a server without internet access: a folder of model
# folders by name, like ~/.paddlex/official_models (PP-DocLayoutV3/, ...), or the model's own folder
# (inference.yml, inference.json, inference.pdiparams). Blank = PaddleX downloads them to ~/.paddlex.
# LAYOUT_MODEL_DIR=/models/paddle
PAGE_MAX_CHARS=6000         # translate page by page; longer pages split into parts
CARRY_CONTEXT_CHARS=1500    # previous source+translation carried into each page
REVIEW_MAX_ROUNDS=2      # max refine passes after review
MAX_CONCURRENCY=2        # parallel LLM calls (keep low for local models)
MAX_PARALLEL_RUNS=2        # pipelines/tasks at once across documents (more are queued)
TEMPERATURE=0.2

DATA_DIR=data

# Max uncertain-term questions per translation/review batch
MAX_QUESTIONS_PER_BATCH=3

# Whole-document analysis before translating (brief, key terms, questions asked up front)
ANALYSIS_ENABLED=true
MAX_QUESTIONS=6            # questions asked before translating
ANALYSIS_CHUNK_CHARS=40000 # characters per analysis call; must fit the model's context (--max-model-len):
                           # ~40k characters is ~10k tokens of German but can be ~30k+ of Chinese

# Robustness and speed
MODEL_RETRIES=5            # per model call: rate limits (exponential backoff) and API errors
MODEL_TIMEOUT=180          # seconds per model call before it is retried
REVIEW_REASONING_TOKENS=2000   # cap on the reviewer's / LQA's hidden thinking (vLLM thinking_token_budget; needs
                               # --reasoning-parser on that server, else the call is sent again uncapped); 0 = no cap
OCR_CHECK=auto             # auto: skip the OCR check where the transcription equals the PDF text layer; always
