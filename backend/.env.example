# Copy to backend/.env. Models are NOT set here: config/models.yaml lists them (copy config/models.example.yaml)
# and config/pipeline.yaml says which model does each step. This file holds their secrets, which the YAML files
# refer to as ${NAME}, and the pipeline settings below.

# ---------------------------------------------------------------------------
# Secrets used by config/models.yaml (any names you like; models.yaml refers to them as ${NAME})
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# VLLM_API_KEY=
# GATEWAY_TOKEN=

# Other places for the model files (defaults: config/models.yaml and config/pipeline.yaml)
# MODELS_FILE=config/models.yaml
# PIPELINE_FILE=config/pipeline.yaml

# ---------------------------------------------------------------------------
# Dictionary service (any endpoint answering the contract in dictionary-server/README.md; blank = off).
# A dummy one for development: python3 dictionary-server/server.py
# ---------------------------------------------------------------------------
# DICTIONARY_URL=http://localhost:8200/lookup
# DICTIONARY_API_KEY=
# DICTIONARY_HEADERS={"X-Client": "translator"}

# ---------------------------------------------------------------------------
# Reading the source
# ---------------------------------------------------------------------------
OCR_DPI=150
OCR_CHECK_ENABLED=true     # OCR check: small fixes (or ones the PDF's text layer confirms) applied, others listed
OCR_CHECK=auto             # auto: skip the OCR check where the reading equals the PDF's text layer; always
FIGURE_DETECTION=auto      # auto (the PDF's embedded images + pictures PP-DocLayoutV3 finds) | off
FIGURE_TEXT=true           # read the text inside figures and translate it as a legend
FIGURE_CHECK=auto          # auto: the OCR model looks at each picture first; plain text is read as text | off
FIGURE_TEXT_COVER=0.6      # confident text regions covering this much of a "picture": it's text, not a picture
OFFICE_PICTURES=auto       # Word / PowerPoint / Excel pictures: the OCR model reads their text, translated as alt text + caption | off
OFFICE_PICTURE_MIN_CM=1.5  # pictures smaller than this on their short side (icons) are left alone
OFFICE_PICTURE_MAX=60      # pictures read per file at most

# The layout MCP server: PP-DocLayoutV3 finds the pictures on pages (blank LAYOUT_SERVER_DIR: PDF images only)
LAYOUT_SERVER_DIR=../layout-server
LAYOUT_MODEL=PP-DocLayoutV3
LAYOUT_THRESHOLD=0.3       # minimum confidence for a region (text regions are evidence against false pictures)
# LAYOUT_THRESHOLDS={"image": 0.55, "chart": 0.55, "seal": 0.45}   # per class (JSON); these are the defaults
# Where the PP-DocLayoutV3 model files are, e.g. on a server without internet access: a folder of model
# folders by name, like ~/.paddlex/official_models (PP-DocLayoutV3/, ...), or the model's own folder
# (inference.yml, inference.json, inference.pdiparams). Blank = PaddleX downloads them to ~/.paddlex.
# LAYOUT_MODEL_DIR=/models/paddle

# ---------------------------------------------------------------------------
# Translating
# ---------------------------------------------------------------------------
ANALYSIS_ENABLED=true      # whole-document analysis before translating (brief, key terms, questions up front)
MAX_QUESTIONS=6            # questions asked before translating
ANALYSIS_CHUNK_CHARS=40000 # characters per analysis call; must fit the model's context (--max-model-len):
                           # ~40k characters is ~10k tokens of German but can be ~30k+ of Chinese
MAX_QUESTIONS_PER_BATCH=3  # late questions per translation/review batch
PAGE_MAX_CHARS=6000        # translate page by page; longer pages split into parts
CARRY_CONTEXT_CHARS=1500   # previous source+translation carried into each page
REVIEW_MAX_ROUNDS=2        # max refine passes after review

# ---------------------------------------------------------------------------
# Throughput and storage
# ---------------------------------------------------------------------------
MAX_CONCURRENCY=2          # parallel model calls within one run (keep low for small servers)
MAX_PARALLEL_RUNS=2        # pipelines/tasks at once across documents (more are queued)
DATA_DIR=data
