# ---------------------------------------------------------------------------
# Models (LiteLLM naming). Every role falls back to MODEL / MODEL_API_BASE.
#   OpenRouter:                  MODEL=openrouter/anthropic/claude-haiku-5.5  MODEL_API_BASE=  MODEL_API_KEY=  OPENROUTER_API_KEY=...
#   Ollama (OpenAI-compatible):  MODEL=openai/<ollama-model>  MODEL_API_BASE=http://localhost:11434/v1
#   OpenAI:                      MODEL=openai/gpt-5.1         MODEL_API_BASE=     OPENAI_API_KEY=...
#   Anthropic:                   MODEL=anthropic/claude-sonnet-5-5  MODEL_API_BASE=  ANTHROPIC_API_KEY=...
#   Gemini (native ADK client):  MODEL=gemini-2.5-flash      MODEL_API_BASE=     GOOGLE_API_KEY=...
# OCR roles need a vision-capable model.
# ---------------------------------------------------------------------------
MODEL=openai/gemma4
MODEL_API_BASE=http://localhost:11434/v1
MODEL_API_KEY=ollama

# Per-role overrides (set *_API_BASE= to empty to stop inheriting MODEL_API_BASE):
# OCR_MODEL=
# OCR_CHECK_MODEL=
# TRANSLATE_MODEL=
# REVIEW_MODEL=
# EDITOR_MODEL=          # needs tool calling
# LQA_MODEL=             # quality scoring; unset = REVIEW model, set another for a second opinion

# Pipeline
OCR_DPI=150
OCR_CHECK_ENABLED=true
FIGURE_DETECTION=auto      # auto | layout | vision | pdf | off (auto = PDF images + PP-DocLayout, else vision boxes)
FIGURE_TEXT=true           # read + translate text inside figures as a legend

# PP-DocLayout MCP server (blank LAYOUT_SERVER_DIR disables it)
LAYOUT_SERVER_DIR=../layout-server
LAYOUT_MODEL=PP-DocLayout_plus-L
PAGE_MAX_CHARS=6000         # translate page by page; longer pages split into parts
CARRY_CONTEXT_CHARS=1500    # previous source+translation carried into each page
REVIEW_MAX_ROUNDS=2      # max refine passes after review
MAX_CONCURRENCY=2        # parallel LLM calls (keep low for local models)
MAX_PARALLEL_RUNS=2        # pipelines/tasks at once across documents (more are queued)
TEMPERATURE=0.2

DATA_DIR=data

# Max uncertain-term questions per translation/review batch
MAX_QUESTIONS_PER_BATCH=3

# Whole-document analysis before translating (brief, key terms, questions asked up front)
ANALYSIS_ENABLED=true
MAX_QUESTIONS=6            # questions asked before translating

# Robustness and speed
MODEL_RETRIES=5            # per model call: rate limits (exponential backoff) and API errors
MODEL_TIMEOUT=180          # seconds per model call before it is retried
REVIEW_REASONING_TOKENS=2000   # cap on the reviewer's / LQA's hidden reasoning (OpenRouter reasoning models); 0 = no cap
OCR_CHECK=auto             # auto: skip the OCR check where the transcription equals the PDF text layer; always
